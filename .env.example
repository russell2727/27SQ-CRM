DATABASE_URL=postgres://user:pass@localhost:5432/crm
SESSION_SECRET=change-me
NODE_ENV=development
APP_URL=http://localhost:3000

# Email notifications (optional) — either SMTP_URL or the SMTP_* set
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=27 Squared CRM <crm@27squaredmarketing.com>
# IMAP_HOST=imap.gmail.com      reply capture; defaults to Gmail when SMTP_HOST is Gmail, reuses SMTP_USER/SMTP_PASS
# IMAP_POLL_SECONDS=60
# SEQ_SEND_HOUR=9              sequence steps send at this local hour (DIGEST_TZ), weekdays
# DIGEST_HOUR=8
# DIGEST_TZ=America/New_York

# DocuSign (optional) — JWT grant
# DS_INTEGRATION_KEY=
# DS_USER_ID=
# DS_ACCOUNT_ID=
# DS_PRIVATE_KEY_B64=      base64 of the RSA private key PEM:  base64 -w0 private.key
# DS_ENV=production         or demo (developer sandbox)
# DS_WEBHOOK_SECRET=        HMAC key set on the DocuSign Connect configuration

# Google Calendar sync (optional) — service account with domain-wide delegation, scope calendar.readonly
# GOOGLE_SA_JSON_B64=       base64 of the service-account JSON key
# CALENDAR_POLL_MINUTES=10
